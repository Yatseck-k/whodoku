{
    "name": "yatseck/whodoku",
    "description": "Whodoku detective puzzle game",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0",
        "orchid/platform": "^14.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Whodoku\\": "src/",
            "Whodoku\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Whodoku\\Providers\\WhodokuServiceProvider"]
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
